# Copy to .env and fill in. .env is git-ignored; never commit real values.
# The app itself needs no variables today.

# Expo access token, only for building from CI (expo.dev → Account settings → Access tokens).
# Locally, `eas login` is enough.
EXPO_TOKEN=

# Note: any EXPO_PUBLIC_* variable is bundled into the app and readable by anyone who
# downloads it. Never put secrets in EXPO_PUBLIC_* variables.
